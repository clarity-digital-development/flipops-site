/data/raw/
google-oauth2-web-credentials.json
google-sheet-config.json
oauth-token.json
oauth-credentials.json
*-service-account.json
*-credentials.json

# wrangler
.wrangler/
.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

