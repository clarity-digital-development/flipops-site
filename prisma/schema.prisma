// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User/Investor - Multi-tenant support
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  // NextAuth credentials provider (M2.5). bcrypt hash; NULL = user has not
  // been issued credentials yet (manual/programmatic creation policy).
  passwordHash    String?
  name            String?
  companyName     String?

  // Investment preferences
  targetMarkets   String    // JSON array: ["Miami-Dade, FL", "Maricopa, AZ"]
  propertyTypes   String?   // JSON array: ["single_family", "multi_family"]
  minScore        Int       @default(70) // Minimum property score to alert
  maxBudget       Float?    // Maximum deal budget

  // Detailed investor profile for personalized lead generation
  investorProfile String?   // JSON: { strategies, priceRanges, distressWeights, dealBreakers, etc. }

  // Investor type and multi-strategy support
  investorType       String?   // "wholesaler", "flipper", "buy_and_hold", "hybrid"
  onboardingComplete Boolean   @default(false)

  // Notification preferences
  slackWebhook    String?   // User-specific Slack webhook
  emailAlerts     Boolean   @default(true)
  dailyDigest     Boolean   @default(true)
  digestTime      String?   // Time for daily digest (e.g., "08:00")
  timezone        String    @default("America/New_York")

  // Subscription & billing
  tier            String    @default("pro") // free, pro, enterprise
  monthlyDeals    Int       @default(0) // Track usage for tiered pricing
  subscriptionStatus String @default("active") // active, paused, cancelled
  stripeCustomerId   String? @unique // Stripe Customer ID; populated on first checkout.session.completed

  // Platform settings
  onboarded       Boolean   @default(false)
  onboardedAt     DateTime?
  currency        String    @default("USD")

  // Email signature settings
  emailSignatureEnabled Boolean @default(false)
  emailSenderName       String?
  emailCompanyName      String?
  emailSignature        String?

  // Team settings
  currentTeamId   String?   // Currently active team for this user

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  // Relations
  properties      Property[]
  deals           DealSpec[]
  policies        Policy[]
  vendors         Vendor[]        // Legacy vendor model (to be deprecated)
  tasks           Task[]
  dealAnalyses    DealAnalysis[]
  offers          Offer[]
  contracts       Contract[]
  buyers          Buyer[]
  rentals         Rental[]
  buyerOffers     BuyerOffer[]
  campaigns       Campaign[]
  dispositionListings DispositionListing[]      // M3.5 flipper sale workflow

  // New Vendor Network System relations
  userVendors           UserVendor[]              // User's private vendors
  vendorRelationships   UserVendorRelationship[]  // User's relationships with platform vendors
  vendorJobs            VendorJob[]               // User's job history with vendors

  // ML behavioral signals
  leadEvents            LeadEvent[]               // Behavioral training signal

  // Deferred-followups (Sprint 2.5)
  telnyxNumbers         TelnyxNumber[]            // User-owned Telnyx phone numbers (SMS/voice scoping)
  notifications         Notification[]            // User-scoped notifications
  activities            Activity[]                // User-scoped activities (userId source-of-truth)

  @@index([email])
  @@index([tier])
  @@index([currentTeamId])
}

// Core deal specification
model DealSpec {
  id              String    @id @default(cuid())
  userId          String    // Multi-tenant: which investor owns this deal
  propertyId      String?   // Link to property (for flippers starting renovation)
  contractId      String?   @unique // Link to contract (for flippers starting renovation)
  address         String
  type            String    // SFH, multi-family, commercial
  maxExposureUsd  Float
  targetRoiPct    Float
  arv             Float?    // After Repair Value for ROI calculations
  region          String?   @default("Miami")
  grade           String?   @default("Standard")
  status          String    @default("planning") // "planning", "active", "on_hold", "completed", "cancelled"
  startAt         DateTime?
  completedAt     DateTime? // When renovation was completed
  dailyBurnUsd    Float?    @default(0)
  constraints     String    // Array of constraint objects (JSON string)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  contract        Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  scopeNodes      ScopeTreeNode[]
  bids            Bid[]
  changeOrders    ChangeOrder[]
  events          Event[]
  budgetLedger    BudgetLedger?
  tasks           Task[]
  vendorJobs      VendorJob[] // Jobs assigned to vendors for this renovation
  dispositionListings DispositionListing[] // M3.5 — listings fed from a completed renovation

  @@index([userId])
  @@index([propertyId])
  @@index([contractId])
  @@index([address])
  @@index([status])
  @@index([createdAt])
}

// Scope tree for work breakdown
model ScopeTreeNode {
  id          String    @id @default(cuid())
  dealId      String
  trade       String    // HVAC, Plumbing, Electrical, etc.
  task        String    // Specific task within trade
  quantity    Json      // {value: number, unit: string, method: string}
  finishLvl   String?   // Standard, Premium, Luxury
  assumptions Json      // Array of assumption strings (stored as JSON for SQLite)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  deal        DealSpec  @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, trade, task])
  @@index([dealId])
  @@index([trade])
}

// Cost model for estimation
model CostModel {
  id              String    @id @default(cuid())
  region          String    // Geographic region
  grade           String    // Standard, Premium, Luxury
  trade           String    // Trade category
  task            String    // Specific task
  unit            String    // sqft, lf, ea, etc.
  material        Float     // Material cost per unit
  labor           Float     // Labor cost per unit
  contingencyPct  Float     // Default contingency percentage
  riskPremiumPct  Float     // Risk premium percentage
  source          String?   // Data source
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@unique([region, grade, trade, task, unit])
  @@index([region, grade])
  @@index([trade, task])
}

// Budget tracking ledger
model BudgetLedger {
  dealId              String    @id
  baseline            String      // Baseline budget by trade
  committed           String      // Committed costs by trade
  actuals             String      // Actual costs by trade
  variance            String      // Variance analysis by trade
  contingencyRemaining Float    // Remaining contingency
  updatedAt           DateTime  @updatedAt
  createdAt           DateTime  @default(now())

  // Relations
  deal                DealSpec  @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

// Vendor bid tracking
model Bid {
  id          String    @id @default(cuid())
  dealId      String
  vendorId    String
  items       String      // Array of bid line items: {trade, task, quantity, unit, unitPrice, totalPrice}
  subtotal    Float
  includes    Json      // What's included (stored as JSON for SQLite)
  excludes    Json      // What's excluded (stored as JSON for SQLite)
  status      String    @default("pending") // pending, awarded, rejected
  normalized  Json?     // Normalized bid data for comparison
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  deal        DealSpec  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  vendor      Vendor?   @relation(fields: [vendorId], references: [id])

  @@index([dealId])
  @@index([vendorId])
  @@index([status])
}

// Change order management
model ChangeOrder {
  id          String    @id @default(cuid())
  dealId      String
  trade       String
  deltaUsd    Float     // Cost change
  impactDays  Int       // Schedule impact in days
  status      String    // proposed, approved, denied
  rationale   String?   // Reason for change or denial
  simResults  Json?     // Simulation results cache
  decidedAt   DateTime? // When decision was made
  decidedBy   String?   // Who/what made the decision
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  deal        DealSpec  @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([status])
  @@index([trade])
}

// Immutable event log
model Event {
  id          String    @id @default(cuid())
  dealId      String?
  actor       String    // User ID or system component
  artifact    String    // What was affected (DealSpec, Bid, etc.)
  action      String    // CREATE, UPDATE, DELETE, APPROVE, BLOCK, etc.
  diff        String?     // JSON Patch diff
  checksum    String    // SHA-256 hash for integrity
  ts          DateTime  @default(now())

  // Relations
  deal        DealSpec? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([actor])
  @@index([artifact])
  @@index([ts])
}

// LEGACY: Vendor management (being replaced by Vendor Network System below)
// Migration: Data will move to UserVendor (for user-created vendors)
// Keep for now to maintain Bid/Invoice relations during transition
model Vendor {
  id              String    @id @default(cuid())
  userId          String?   // Multi-tenant: user-specific vendor, null = shared/platform vendor
  name            String
  email           String?
  phone           String?
  trade           String      // Array of trades they handle (stored as JSON for SQLite)
  region          String?
  onTimePct       Float     @default(100) // On-time percentage
  onBudgetPct     Float     @default(100) // On-budget percentage
  reliability     Float     @default(100) // Overall reliability score
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bids            Bid[]
  invoices        Invoice[]

  @@index([userId])
  @@index([trade])
  @@index([region])
}

// Invoice tracking
model Invoice {
  id          String    @id @default(cuid())
  dealId      String
  vendorId    String?
  trade       String
  lineItemId  String?   // Optional link to specific line item
  amount      Float
  docUrl      String?   // S3 URL to document
  status      String    @default("pending") // pending, approved, paid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  vendor      Vendor?   @relation(fields: [vendorId], references: [id])

  @@index([dealId])
  @@index([vendorId])
  @@index([status])
}

// Policy configuration by region and grade
model Policy {
  id                   String    @id @default(cuid())
  userId               String?   // Multi-tenant: user-specific policy, null = global default
  region               String
  grade                String    // Standard, Premium, Luxury
  maxExposureUsd       Float
  targetRoiPct         Float
  contingencyTargetPct Float
  varianceTier1Pct     Float    // 3% default
  varianceTier2Pct     Float    // 7% default
  bidSpreadMaxPct      Float    // 15% default
  coSlaHours           Int       // Change order SLA in hours
  updatedBy            String?
  updatedAt            DateTime  @updatedAt
  createdAt            DateTime  @default(now())

  // Relations
  user                 User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, region, grade])
  @@index([userId])
  @@index([region, grade])
}

// Property discovery and scoring
model Property {
  id               String   @id @default(cuid())
  userId           String   // Multi-tenant: which investor owns this property lead
  address          String
  city             String
  state            String
  zip              String
  county           String?
  apn              String?  // Assessor Parcel Number
  ownerName        String?

  // Property details
  propertyType     String?
  bedrooms         Int?
  bathrooms        Int?
  squareFeet       Int?
  lotSize          Int?
  yearBuilt        Int?

  // Financial
  assessedValue    Float?
  taxAmount        Float?
  lastSaleDate     String?
  lastSalePrice    Float?
  estimatedValue   Float?

  // Listing/Market info
  listingDate      DateTime?  // When property was listed
  daysOnMarket     Int?       // Calculated or provided DOM

  // Scoring (optional until calculated)
  score            Int?
  scoreBreakdown   String?  // JSON string with score details
  scoredAt         DateTime?
  potentialProfit  Float?

  // Distress flags
  foreclosure      Boolean  @default(false)
  preForeclosure   Boolean  @default(false)
  taxDelinquent    Boolean  @default(false)
  vacant           Boolean  @default(false)
  bankruptcy       Boolean  @default(false)
  absenteeOwner    Boolean  @default(false)

  // Contact info (from skip tracing)
  phoneNumbers     String?  // JSON array
  emails           String?  // JSON array

  // Outreach tracking (sales workflow)
  outreachStatus      String?   @default("not_contacted")
  // Status values: "not_contacted", "attempted", "contacted", "offer_made",
  //                "negotiating", "under_contract", "dead", "closed"
  lastContactDate     DateTime?
  lastContactMethod   String?   // "phone", "email", "sms", "in_person"
  contactNotes        String?   // JSON array: [{date, note, method, sentiment}]
  ownerResponse       String?   // "interested", "not_interested", "callback", "no_answer"
  nextFollowUpDate    DateTime?
  sentiment           String?   // "positive", "neutral", "negative"

  // Offer tracking
  offerAmount         Float?
  offerDate           DateTime?
  offerStatus         String?   // "draft", "sent", "countered", "accepted", "rejected"

  // Source tracking
  dataSource       String
  sourceId         String?
  enriched         Boolean  @default(false)

  // ---------------------------------------------------------------------------
  // Option A (leads-UI integration of freshness-layer Lien data) — Phase A1
  // additions. All nullable / non-default; no migration risk on existing rows.
  // See docs/development/OPTION-A-LEADS-INTEGRATION-DESIGN.json.
  // ---------------------------------------------------------------------------
  countyFips                 String?   // "12031" etc. Enables fast Lien join when promoted from virtual
  taxDelinquentAmount        Float?    // SUM(Lien.amount) WHERE lienCategory='tax'
  taxDelinquentYearsCount    Int?      // distinct delinquent tax years on this APN
  taxDelinquentEarliestYear  Int?      // MIN(year extracted from lienTypeCode)
  taxDelinquentLatestYear    Int?      // MAX(year) — "current" delinquency
  latitude                   Float?    // from Parcel join (for map pin)
  longitude                  Float?    // from Parcel join

  // Metadata
  metadata         String?  // Additional flexible data (JSON string for SQLite)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks            Task[]
  dealAnalyses     DealAnalysis[]
  offers           Offer[]
  contracts        Contract[]
  renovations      DealSpec[]     // Renovation projects for this property
  rentals          Rental[]       // Rental properties
  dispositionListings DispositionListing[] // M3.5 — flipper sale workflow
  dataPoints       PropertyDataPoint[] // Per-field scraped/API provenance

  @@unique([userId, address, city, state, zip])
  @@index([userId])
  @@index([score])
  @@index([city, state])
  @@index([createdAt])
  @@index([dataSource])
  @@index([countyFips, apn])    // promote-from-virtual fast lookup
}

// Task management for investor workflow
model Task {
  id          String   @id @default(cuid())
  userId      String   // Multi-tenant: which investor owns this task
  propertyId  String?  // Optional link to property
  dealId      String?  // Optional link to deal/renovation

  type        String   // "call", "email", "text", "showing", "offer", "follow_up", "custom"
  title       String
  description String?
  dueDate     DateTime
  completed   Boolean  @default(false)
  completedAt DateTime?
  priority    String   @default("medium") // "low", "medium", "high"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  deal        DealSpec? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([userId, completed])
  @@index([propertyId])
  @@index([dealId])
}

// Deal analysis and underwriting
model DealAnalysis {
  id            String   @id @default(cuid())
  userId        String   // Multi-tenant: which investor owns this analysis
  propertyId    String   // Link to property being analyzed

  // ARV (After Repair Value) calculation
  arv           Float
  arvMethod     String   // "median", "weighted", "knn", "manual"
  compsUsed     String?  // JSON array of comparable property data

  // Repair costs
  repairTotal   Float
  repairItems   String?  // JSON array of {category, description, cost}

  // Offer calculation
  maxOffer      Float    // Maximum offer based on rule
  rule          String   @default("70%") // "70%", "75%", "custom"
  offerAmount   Float?   // Actual offer if different from max

  // Purchase and holding costs
  purchasePrice Float?   // Actual purchase price if known
  closingCosts  Float?   // Estimated closing costs
  holdingCosts  Float?   // Monthly holding costs
  holdingMonths Int?     // Expected holding period

  // Profit analysis
  sellingCosts  Float?   // Estimated selling costs (realtor, etc.)
  projectedProfit Float? // Expected profit
  roi           Float?   // Return on investment percentage

  // Metadata
  name          String?  // Optional name for this analysis (e.g., "Conservative", "Aggressive")
  notes         String?  // User notes about this analysis
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([propertyId])
}

// Offer management and tracking
model Offer {
  id            String    @id @default(cuid())
  userId        String    // Multi-tenant: which investor owns this offer
  propertyId    String    // Property being offered on
  analysisId    String?   // Optional link to deal analysis

  // Offer details
  amount        Float
  terms         String?   // "cash", "financing", "seller_financing", "subject_to"
  contingencies String?   // JSON array: ["inspection", "financing", "appraisal", "sale_of_home"]
  closingDate   DateTime?
  expiresAt     DateTime? // When offer expires if not accepted
  earnestMoney  Float?    // Earnest money deposit amount
  dueDate       DateTime? // Date offer is due/presented

  // Status tracking
  status        String    @default("draft") // "draft", "sent", "countered", "accepted", "rejected", "expired"
  sentAt        DateTime?
  responseAt    DateTime?
  responseNotes String?   // Notes about seller's response

  // Counter-offer tracking
  counterAmount Float?    // If seller countered
  counterTerms  String?   // JSON with counter-offer details
  counterDate   DateTime?

  // Documentation
  documentUrl   String?   // Link to offer letter/PDF
  notes         String?   // Internal notes about this offer

  // Metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contract      Contract?

  @@index([userId, status])
  @@index([propertyId])
  @@index([status])
  @@index([createdAt])
}

// Contract management and closing tracking
model Contract {
  id              String    @id @default(cuid())
  userId          String    // Multi-tenant: which investor owns this contract
  propertyId      String    // Property under contract
  offerId         String    @unique // Link to accepted offer

  // Contract details
  purchasePrice   Float     // Final purchase price
  status          String    @default("pending") // "pending", "signed", "escrow", "closed", "cancelled"

  // Closing timeline
  signedAt        DateTime?
  escrowOpenedAt  DateTime?
  closingDate     DateTime? // Expected closing date
  closedAt        DateTime? // Actual closing date

  // Documentation
  documentUrls    String?   // JSON array of document links
  notes           String?   // Internal notes

  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  offer           Offer               @relation(fields: [offerId], references: [id], onDelete: Cascade)
  assignment      ContractAssignment?
  renovation      DealSpec?           // Renovation project for this contract (flippers)
  rental          Rental?             // Rental property for this contract (buy-and-hold)
  buyerOffers     BuyerOffer[]        // Offers from buyers on this contract
  campaigns       Campaign[]          // Marketing campaigns for this contract
  dispositionListings DispositionListing[] // M3.5 — sale-side listing(s) for this deal

  @@index([userId, status])
  @@index([propertyId])
  @@index([status])
  @@index([createdAt])
}

// M3.5 — Disposition (flipper-primary sale workflow). One row per
// (userId, propertyId): a property that has finished acquisition/rehab and is
// being taken to sale. Seeded from a completed renovation (DealSpec) and/or its
// purchase Contract, then tracked prep → listed → pending → sold.
//
// List-vs-ARV uses ParcelValuation (the M3.3 AVM), joined by value on the
// property's countyFips+apn at read time. arvAtList snapshots that AVM when the
// listing is created so the variance badge stays stable as the model recomputes.
// The sale-side net sheet (commission/closing/payoff → net proceeds) is computed
// client-side from the stored assumptions via lib/disposition/net-sheet.ts.
model DispositionListing {
  id              String    @id @default(cuid())
  userId          String    // Multi-tenant owner
  propertyId      String    // The asset being sold
  contractId      String?   // Purchase contract (basis for payoff / net sheet)
  dealSpecId      String?   // The completed renovation that fed this listing

  // Lifecycle: "prepping", "listed", "pending", "sold", "cancelled"
  status          String    @default("prepping")

  // Listing-agent handoff (flippers sell on MLS via an agent)
  listAgentName       String?
  listAgentBrokerage  String?
  listAgentPhone      String?
  listAgentEmail      String?

  // Pricing / market
  listPrice       Float?
  listedAt        DateTime?
  arvAtList       Float?    // AVM snapshot captured at create/list time

  // Sale-side net-sheet assumptions
  commissionPct   Float     @default(6)    // total agent commission, % of sale price
  closingCostPct  Float     @default(1.5)  // seller closing costs, % of sale price
  payoffAmount    Float?    @default(0)     // loan payoff + basis to net against

  // Outcome
  soldPrice       Float?
  soldAt          DateTime?

  // Listing-prep checklist — JSON array of { key, label, done }
  prepChecklist   String?

  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contract        Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  dealSpec        DealSpec? @relation(fields: [dealSpecId], references: [id], onDelete: SetNull)

  @@unique([userId, propertyId])
  @@index([userId, status])
  @@index([propertyId])
  @@index([dealSpecId])
  @@index([status])
}

// Buyer database for wholesalers
model Buyer {
  id              String   @id @default(cuid())
  userId          String   // Multi-tenant: which investor (wholesaler) owns this buyer

  // Buyer details
  name            String
  email           String?
  phone           String?
  company         String?

  // Buyer preferences
  propertyTypes   String?  // JSON array: ["single_family", "multi_family"]
  minPrice        Float?
  maxPrice        Float?
  targetMarkets   String?  // JSON array: ["Miami-Dade, FL", "Maricopa, AZ"]
  cashBuyer       Boolean  @default(false)

  // Relationship tracking
  dealsClosed     Int      @default(0)  // Number of deals closed with this buyer
  totalRevenue    Float    @default(0)  // Total assignment fees from this buyer
  reliability     String   @default("unknown") // "unknown", "reliable", "unreliable"

  // Notes
  notes           String?  // Internal notes about this buyer

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments     ContractAssignment[]
  buyerOffers     BuyerOffer[]

  @@index([userId])
  @@index([email])
  @@index([name])
}

// Contract assignment for wholesaling
model ContractAssignment {
  id              String    @id @default(cuid())
  contractId      String    @unique // One-to-one with contract
  buyerId         String    // Which buyer is taking the contract

  // Assignment details
  assignmentFee   Float     // Fee charged for assigning the contract
  assignmentDate  DateTime? // When assignment was signed
  status          String    @default("pending") // "pending", "signed", "closed", "cancelled"

  // Payment tracking
  feeReceived     Boolean   @default(false)
  feeReceivedDate DateTime?

  // Documentation
  documentUrls    String?   // JSON array of assignment agreement documents
  notes           String?   // Internal notes

  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  buyer           Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

// Buyer offers on wholesale deals/contracts
model BuyerOffer {
  id              String    @id @default(cuid())
  userId          String    // Multi-tenant: which investor (wholesaler) owns this
  contractId      String    // Contract being offered on
  buyerId         String    // Buyer making the offer

  // Offer details
  offerPrice      Float     // Buyer's offer price
  terms           String?   // Cash, financing, etc.
  earnestMoney    Float?    // EMD amount
  closingDays     Int?      // Days to close
  contingencies   String?   // JSON array of contingencies
  expiresAt       DateTime? // When offer expires

  // Status tracking
  status          String    @default("submitted") // "submitted", "countered", "accepted", "rejected", "expired"
  submittedAt     DateTime  @default(now())
  responseAt      DateTime?
  responseNotes   String?

  // Counter-offer tracking
  counterAmount   Float?
  counterTerms    String?   // JSON with counter details

  // Notes
  notes           String?

  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  buyer           Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contractId])
  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

// Marketing campaigns for wholesalers to blast listings to buyers
model Campaign {
  id              String    @id @default(cuid())
  userId          String    // Multi-tenant: which investor owns this campaign
  contractId      String?   // Optional link to a specific contract/listing

  // Campaign details
  name            String
  subject         String?   // Email subject line
  message         String    // Campaign message content
  method          String    @default("email") // "email", "sms", "both"

  // Recipient tracking
  buyerIds        String?   // JSON array of buyer IDs
  recipientCount  Int       @default(0)

  // Delivery tracking
  status          String    @default("draft") // "draft", "scheduled", "sent", "cancelled"
  scheduledAt     DateTime?
  sentAt          DateTime?

  // Performance metrics
  openCount       Int       @default(0)
  clickCount      Int       @default(0)
  replyCount      Int       @default(0)
  offerCount      Int       @default(0)

  // Telnyx dispatch counters (Sprint 2.5 deferred-followups)
  sentCount       Int       @default(0)
  deliveredCount  Int       @default(0)
  failedCount     Int       @default(0)

  // Notes
  notes           String?

  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract        Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  recipients      CampaignRecipient[] // Per-recipient dispatch tracking (Telnyx)

  @@index([userId])
  @@index([contractId])
  @@index([status])
  @@index([createdAt])
}

// Per-recipient Telnyx dispatch tracking (Sprint 2.5 deferred-followups)
// Maps Telnyx message ID → Campaign row for delivery/failure webhook fan-out.
model CampaignRecipient {
  id              String    @id @default(cuid())
  campaignId      String
  propertyId      String?   // Either propertyId OR buyerId
  buyerId         String?
  telnyxMessageId String?   @unique  // Set on enqueue; null if dispatch never happened
  toPhoneNumber   String    // E.164
  status          String    @default("queued") // queued | sent | delivered | failed
  sentAt          DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?
  repliedAt       DateTime? // stamped when an inbound SMS from toPhoneNumber arrives post-send
  failureReason   String?
  createdAt       DateTime  @default(now())

  // Relations
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([telnyxMessageId])
}

// Telnyx-owned phone numbers (Sprint 2.5 deferred-followups)
// Scopes inbound SMS/voice to the user who owns the 'to' number.
model TelnyxNumber {
  id                  String    @id @default(cuid())
  userId              String
  phoneNumber         String    @unique  // E.164 with '+' prefix
  label               String?            // friendly UI label e.g. "Jacksonville outreach"
  smsEnabled          Boolean   @default(true)
  voiceEnabled        Boolean   @default(true)
  mmsEnabled          Boolean   @default(false)
  messagingProfileId  String?            // Telnyx Messaging Profile ID for SMS routing
  connectionId        String?            // Telnyx Call Control Connection ID for voice
  provisionedAt       DateTime  @default(now())
  lastUsedAt          DateTime?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

// Rental property management for buy-and-hold investors
model Rental {
  id              String    @id @default(cuid())
  userId          String    // Multi-tenant: which investor owns this rental
  propertyId      String    // Link to property
  contractId      String?   @unique // Link to contract (optional, one-to-one)

  // Rental details
  address         String
  monthlyRent     Float     // Monthly rent amount
  deposit         Float?    // Security deposit amount
  leaseStart      DateTime? // Lease start date
  leaseEnd        DateTime? // Lease end date
  status          String    @default("vacant") // "vacant", "leased", "maintenance", "listed"

  // Financial tracking
  purchasePrice   Float?    // Original purchase price
  mortgagePayment Float?    // Monthly mortgage payment
  propertyTax     Float?    // Monthly property tax
  insurance       Float?    // Monthly insurance
  hoa             Float?    // Monthly HOA fees
  utilities       Float?    // Monthly utilities (if paid by landlord)
  maintenance     Float?    // Estimated monthly maintenance reserve

  // Performance metrics
  totalIncome     Float     @default(0) // Total rental income collected
  totalExpenses   Float     @default(0) // Total expenses paid
  occupancyRate   Float     @default(0) // Percentage of time occupied

  // Notes
  notes           String?   // Internal notes

  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contract        Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  tenants         Tenant[]
  income          RentalIncome[]
  expenses        RentalExpense[]

  @@index([userId])
  @@index([propertyId])
  @@index([contractId])
  @@index([status])
  @@index([createdAt])
}

// Tenant management
model Tenant {
  id              String    @id @default(cuid())
  rentalId        String    // Link to rental property

  // Tenant details
  name            String
  email           String?
  phone           String?
  emergencyContact String?  // JSON: {name, phone, relationship}

  // Lease details
  leaseStart      DateTime
  leaseEnd        DateTime
  monthlyRent     Float
  deposit         Float?
  status          String    @default("active") // "active", "notice_given", "moved_out", "evicted"

  // Move-in/out tracking
  moveInDate      DateTime?
  moveOutDate     DateTime?
  moveOutReason   String?   // "lease_ended", "evicted", "early_termination", "purchased"

  // Payment tracking
  paymentMethod   String?   // "check", "ach", "cash", "online"
  autoPay         Boolean   @default(false)
  latePayments    Int       @default(0) // Count of late payments

  // Notes
  notes           String?   // Internal notes about tenant

  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  rental          Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@index([status])
  @@index([leaseEnd])
}

// Rental income tracking
model RentalIncome {
  id              String    @id @default(cuid())
  rentalId        String    // Link to rental property

  // Income details
  amount          Float
  type            String    @default("rent") // "rent", "late_fee", "pet_fee", "parking", "other"
  description     String?
  receivedDate    DateTime
  dueDate         DateTime? // When payment was due (for late tracking)

  // Payment method
  paymentMethod   String?   // "check", "ach", "cash", "online"
  referenceNumber String?   // Check number, transaction ID, etc.

  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  rental          Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@index([receivedDate])
  @@index([type])
}

// Rental expense tracking
model RentalExpense {
  id              String    @id @default(cuid())
  rentalId        String    // Link to rental property

  // Expense details
  amount          Float
  category        String    // "mortgage", "tax", "insurance", "hoa", "maintenance", "utilities", "other"
  description     String?
  expenseDate     DateTime

  // Payment tracking
  paid            Boolean   @default(false)
  paidDate        DateTime?
  paymentMethod   String?   // "check", "ach", "credit_card", "cash"
  referenceNumber String?   // Check number, transaction ID, etc.

  // Documentation
  receiptUrl      String?   // Link to receipt/invoice

  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  rental          Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@index([expenseDate])
  @@index([category])
  @@index([paid])
}

// Notification and event tracking
model Notification {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String   // g1.denied, property.alert, etc.
  dealId      String?
  userId      String?  // nullable for backward compat with existing rows that have no user scope
  message     String
  metadata    String?  // Flexible metadata including dedupe_hash (JSON string for SQLite)
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  processed   Boolean  @default(false)
  readAt      DateTime?

  // Relations
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, occurredAt])
  @@index([dealId])
  @@index([processed])
  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}

// =============================================================================
// VENDOR NETWORK SYSTEM
// =============================================================================
// Architecture:
// - PlatformVendor: Shared vendors sourced from APIs (Google Places), associated with markets
// - UserVendor: Private vendors created by individual users
// - UserVendorRelationship: Junction linking users to platform vendors with user-specific data
// - VendorJob: Track work history with both vendor types
// =============================================================================

// Vendor trade categories - comprehensive list for real estate renovation
enum VendorCategory {
  GENERAL_CONTRACTOR
  ROOFER
  PLUMBER
  ELECTRICIAN
  HVAC
  FLOORING
  PAINTER
  LANDSCAPER
  DUMPSTER_RENTAL
  LOCKSMITH
  CLEANING_SERVICE
  HOME_INSPECTOR
  APPRAISER
  DEMOLITION
  FRAMING
  SIDING
  WINDOWS
  INSULATION
  DRYWALL
  KITCHEN
  BATHROOM
  FENCING
  CONCRETE
  POOL
  PEST_CONTROL
  GARAGE_DOOR
  APPLIANCE_REPAIR
  OTHER
}

// Source of vendor data for attribution and refresh tracking
enum VendorSource {
  GOOGLE_PLACES   // Primary source: Google Places API
  YELP            // Alternative: Yelp API
  MANUAL          // Manually entered by admin
  PARTNER         // Future: verified partner vendors
}

// Vendor operational status
enum VendorStatus {
  ACTIVE          // Currently operating
  INACTIVE        // Temporarily not operating
  CLOSED          // Permanently closed
  UNVERIFIED      // Needs verification
}

// Market/Metro area for geographic vendor grouping
// Platform vendors are associated with markets, shared across all users in that market
model Market {
  id          String   @id @default(cuid())
  name        String   // Display name: "Jacksonville, FL"
  city        String   // City name for matching
  state       String   // State code (FL, AZ, etc.)
  country     String   @default("US")

  // Geographic center for radius-based queries
  latitude    Float?
  longitude   Float?
  radiusMiles Int      @default(50) // Default search radius

  // Market status
  isActive    Boolean  @default(true) // Whether we're actively sourcing vendors here

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  platformVendors PlatformVendor[]

  @@unique([city, state, country])
  @@index([state])
  @@index([isActive])
}

// Platform-sourced vendors (shared across all users in a market)
// These are pre-populated from public data sources (Google Places API)
// No duplication per user - users create relationships to add to their list
model PlatformVendor {
  id              String           @id @default(cuid())

  // === Basic Business Info ===
  name            String
  description     String?          // Business description from source

  // === Location ===
  address         String?          // Full street address
  city            String
  state           String
  zip             String?
  latitude        Float?           // For map display and distance calculations
  longitude       Float?

  // === Contact Info ===
  phone           String?
  email           String?          // Often not available from Google
  website         String?

  // === Categorization ===
  // Using array of enums for multi-trade vendors (e.g., GC who does plumbing)
  categories      VendorCategory[]

  // === Source & External IDs ===
  source          VendorSource     @default(GOOGLE_PLACES)
  googlePlaceId   String?          @unique // Google Places unique ID
  yelpId          String?          @unique // Yelp business ID

  // === Public Ratings (from source) ===
  sourceRating      Float?         // e.g., Google rating 4.5 (1-5 scale)
  sourceReviewCount Int?           // e.g., 127 reviews
  priceLevel        Int?           // Google price level 1-4 ($ to $$$$)

  // === Business Details ===
  licenseNumber     String?        // Contractor license if available
  insuranceVerified Boolean        @default(false)
  yearsInBusiness   Int?

  // === Status & Verification ===
  status          VendorStatus     @default(ACTIVE)
  isVerified      Boolean          @default(false) // FlipOps manual verification
  isPartner       Boolean          @default(false) // Future: partner program
  partnerDiscount Float?           // Future: discount percentage for FlipOps users

  // === Data Freshness ===
  lastRefreshedAt DateTime?        // When data was last pulled from source
  refreshFailCount Int             @default(0) // Track consecutive refresh failures

  // === Soft Delete ===
  deletedAt       DateTime?        // Soft delete - don't hard delete if has job history

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // === Relations ===
  marketId        String
  market          Market           @relation(fields: [marketId], references: [id])

  userRelationships UserVendorRelationship[]

  // Indexes for common queries
  @@index([marketId])
  @@index([marketId, status])
  @@index([categories])
  @@index([googlePlaceId])
  @@index([city, state])
  @@index([sourceRating])
  @@index([deletedAt])
}

// User-created private vendors (not from platform, user's personal contacts)
// These belong to a single user and are not shared
model UserVendor {
  id              String           @id @default(cuid())

  // === Owner ===
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // === Basic Business Info ===
  name            String
  description     String?
  contactName     String?          // Primary contact person at the company

  // === Location (optional for private vendors) ===
  address         String?
  city            String?
  state           String?
  zip             String?

  // === Contact Info ===
  phone           String?
  email           String?
  website         String?

  // === Categorization ===
  categories      VendorCategory[]
  tags            String[]         // Custom user tags (e.g., "reliable", "cheap", "fast")

  // === Business Details ===
  licenseNumber     String?
  insuranceVerified Boolean        @default(false)

  // === User's Assessment ===
  personalRating    Float?         // User's rating 1-5 (separate from any public rating)
  notes             String?        // User's private notes
  isFavorite        Boolean        @default(false)
  isPreferred       Boolean        @default(false) // Preferred vendor for their category

  // === Availability ===
  availabilityStatus String?       // "available", "busy", "unavailable", "unknown"

  // === Soft Delete ===
  deletedAt       DateTime?        // Soft delete - preserve job history

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // === Relations ===
  jobs            VendorJob[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([categories])
  @@index([isFavorite])
}

// Junction table: User's relationship with a platform vendor
// This is created when a user "adds" a platform vendor to their personal list
// Stores user-specific data (notes, personal rating, etc.) without duplicating vendor data
model UserVendorRelationship {
  id                String         @id @default(cuid())

  // === User ===
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // === Platform Vendor ===
  platformVendorId  String
  platformVendor    PlatformVendor @relation(fields: [platformVendorId], references: [id])

  // === User-Specific Data ===
  personalRating    Float?         // User's rating 1-5 (separate from Google rating)
  notes             String?        // User's private notes about this vendor
  tags              String[]       // User's custom tags for this vendor
  isFavorite        Boolean        @default(false)
  isPreferred       Boolean        @default(false) // Preferred vendor for this category

  // === Contact Override ===
  // If user has different/better contact info than what's in platform data
  contactName       String?        // Specific person the user works with
  contactPhone      String?        // Direct line vs main business number
  contactEmail      String?

  // === Relationship Tracking ===
  addedAt           DateTime       @default(now()) // When user added this vendor
  lastContactedAt   DateTime?      // Last time user contacted this vendor
  lastUsedAt        DateTime?      // Last time vendor was assigned a job

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // === Relations ===
  jobs              VendorJob[]

  // Composite unique: one relationship per user per platform vendor
  @@unique([userId, platformVendorId])
  @@index([userId])
  @@index([platformVendorId])
  @@index([userId, isFavorite])
  @@index([userId, isPreferred])
}

// Track jobs/projects with vendors (works with both user vendors and platform relationships)
// This enables job history tracking for future features
model VendorJob {
  id              String         @id @default(cuid())

  // === Owner ===
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // === Vendor Link (one of these will be set) ===
  userVendorId              String?
  userVendor                UserVendor?              @relation(fields: [userVendorId], references: [id])

  userVendorRelationshipId  String?
  userVendorRelationship    UserVendorRelationship?  @relation(fields: [userVendorRelationshipId], references: [id])

  // === Link to Deal/Renovation (optional) ===
  dealId          String?
  deal            DealSpec?      @relation(fields: [dealId], references: [id])

  // === Job Details ===
  title           String         // Job title/description
  description     String?        // Detailed description
  category        VendorCategory? // Trade category for this job

  // === Financials ===
  quotedAmount    Float?         // Original quote
  finalAmount     Float?         // Final amount paid

  // === Timeline ===
  scheduledDate   DateTime?      // When job is scheduled
  startDate       DateTime?      // When work started
  completedDate   DateTime?      // When work completed

  // === Assessment (after completion) ===
  qualityRating       Int?       // 1-5 rating for work quality
  timelinessRating    Int?       // 1-5 rating for meeting schedule
  communicationRating Int?       // 1-5 rating for communication
  wouldRecommend      Boolean?   // Would user recommend this vendor?
  reviewNotes         String?    // User's review/notes about the job

  // === Status ===
  status          String         @default("pending") // pending, scheduled, in_progress, completed, cancelled

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([userVendorId])
  @@index([userVendorRelationshipId])
  @@index([dealId])
  @@index([status])
  @@index([completedDate])
}

// =============================================================================
// TEAM MANAGEMENT SYSTEM
// =============================================================================
// Architecture:
// - Team: An organization/company with multiple members
// - TeamMember: Links users to teams with roles and permissions
// - TeamInvite: Pending invitations to join a team
// - Activity: Tracks team member activities for performance analytics
// =============================================================================

// Team roles for access control
enum TeamRole {
  OWNER       // Full admin rights, can delete team
  ADMIN       // Can manage members, settings
  MANAGER     // Can view all deals, assign work
  MEMBER      // Standard access to own work
  VIEWER      // Read-only access
}

// Team/Organization
model Team {
  id              String       @id @default(cuid())
  name            String       // Team/Company name
  slug            String       @unique // URL-friendly identifier
  description     String?      // Team description
  logo            String?      // Logo URL

  // Billing
  tier            String       @default("pro") // free, pro, enterprise
  subscriptionId  String?      // Stripe subscription ID

  // Settings (JSON for flexibility)
  settings        String?      // JSON: { timezone, workingHours, notifications, etc. }

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  members         TeamMember[]
  invites         TeamInvite[]
  activities      Activity[]

  @@index([slug])
}

// Team membership - links users to teams
model TeamMember {
  id              String       @id @default(cuid())
  teamId          String
  userId          String       // Links to User model (via clerkId or id)

  // Member info (cached from User for display)
  name            String
  email           String
  avatar          String?      // Profile picture URL

  // Role and permissions
  role            TeamRole     @default(MEMBER)
  department      String?      // "Acquisition", "Disposition", "Account Manager", etc.
  title           String?      // Job title

  // Status
  isActive        Boolean      @default(true)
  joinedAt        DateTime     @default(now())
  lastActiveAt    DateTime?

  // Performance targets (optional)
  dailyTouchTarget    Int?     // Target calls/touches per day
  monthlyDealTarget   Int?     // Target deals per month
  responseTimeTarget  Int?     // Target response time in minutes

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  activities      Activity[]

  @@unique([teamId, userId])
  @@unique([teamId, email])
  @@index([teamId])
  @@index([userId])
  @@index([teamId, role])
  @@index([teamId, isActive])
}

// Pending team invitations
model TeamInvite {
  id              String       @id @default(cuid())
  teamId          String
  email           String       // Invited email address

  // Invite details
  role            TeamRole     @default(MEMBER)
  department      String?
  title           String?

  // Invite tracking
  invitedBy       String       // User ID who sent invite
  invitedAt       DateTime     @default(now())
  expiresAt       DateTime     // Invite expiration

  // Status
  status          String       @default("pending") // pending, accepted, expired, cancelled
  acceptedAt      DateTime?

  // Token for secure invite link
  token           String       @unique @default(cuid())

  // Relations
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email, status]) // One pending invite per email per team
  @@index([teamId])
  @@index([email])
  @@index([token])
  @@index([status])
}

// Activity tracking for team performance analytics
model Activity {
  id              String       @id @default(cuid())
  teamId          String?      // optional — userId is now the SOURCE OF TRUTH
  memberId        String?      // optional — TeamMember ID
  userId          String?      // nullable until backfilled; SOURCE OF TRUTH going forward

  // Activity details
  type            String       // "call", "sms", "email", "appointment", "offer", "note", "task"
  outcome         String?      // "connected", "no_answer", "left_vm", "wrong_number", "scheduled", "completed"

  // Related entities (optional links)
  propertyId      String?      // If activity is on a property/lead
  dealId          String?      // If activity is on a deal
  contractId      String?      // If activity is on a contract

  // Activity metadata
  duration        Int?         // Duration in seconds (for calls)
  notes           String?      // Activity notes
  sentiment       String?      // "positive", "neutral", "negative"

  // Response tracking
  isFirstContact  Boolean      @default(false) // Was this the first contact?
  responseTime    Int?         // Time to respond in minutes (from lead creation)

  // Timestamps
  occurredAt      DateTime     @default(now()) // When activity happened
  createdAt       DateTime     @default(now())

  // Relations
  team            Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member          TeamMember?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([memberId])
  @@index([teamId, occurredAt])
  @@index([memberId, occurredAt])
  @@index([type])
  @@index([propertyId])
  @@index([dealId])
  @@index([userId, occurredAt])
}

// =============================================================================
// WAITLIST / PRE-LAUNCH RESERVATIONS
// =============================================================================

// Public signup for pre-launch reservation and beta access
model Reservation {
  id                String    @id @default(cuid())

  // Contact info
  email             String
  phone             String?
  city              String
  state             String    // US state code (FL, AZ, etc.)

  // Feature interest feedback (JSON array of feature keys)
  featureInterests  String?   // JSON: ["lead_scoring", "comps_arv", ...]

  // Free-text feedback
  feedback          String?

  // Incentive tracking
  providedFeedback  Boolean   @default(false) // True if user filled out feedback
  trialGranted      Boolean   @default(false) // True if 1-month trial applied
  betaAccess        Boolean   @default(false) // True if full beta access granted

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([email])
  @@index([createdAt])
  @@index([state])
}

// =============================================================================
// SCRAPER INFRASTRUCTURE (Phase 2A — owned data layer)
// =============================================================================
// Replaces BatchData $0.30/call dependency for open beta. Property data is
// scraped directly from county assessors, treasurers, recorders, and clerks.
// API vendors (BatchData) become fallback for unscraped markets.

// Per-field provenance: which source provided this datum, when, and how fresh.
// Lets us show "Source: Duval Tax Office (scraped 2h ago)" badges in the UI
// and prioritize fresh county data over stale vendor data.
model PropertyDataPoint {
  id          String   @id @default(cuid())
  propertyId  String
  field       String   // "tax_delinquent" | "open_mortgage_balance" | "owner_name" | etc.
  value       String   @db.Text  // JSON-encoded — handles primitive + structured values
  source      String   // "batchdata" | "scraper:fl-duval-treasurer" | "manual"
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime?
  confidence  Float?   // 0-1, lower for OCR-extracted or inferred fields

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, field, source])
  @@index([propertyId])
  @@index([fetchedAt])
  @@index([source])
}

// Registry of every county we know how to scrape. Populated as users onboard
// markets — the cron worker iterates this table to refresh data.
model CountyScraper {
  id              String   @id @default(cuid())
  countyFips      String   @unique          // "12031" for Duval FL — the canonical join key
  state           String                    // "FL"
  county          String                    // "Duval"
  status          String   @default("pending") // "active" | "broken" | "pending" | "disabled" | "blocked_by_subscription" | "blocked_by_login"
  scraperType     String                    // "iasworld" | "patriot" | "vision" | "manatron" | "custom" | "playwright" | "subscription"
  parserModule    String                    // "lib/scrapers/counties/fl-duval" — import path
  endpoints       Json                      // { assessor: url, treasurer: url, recorder: url, clerk: url }
  rateLimitMs     Int      @default(1500)   // ms between requests to this county

  // Access tier — drives ops strategy. See docs/development/SCRAPER-COVERAGE.md for the full breakdown.
  accessTier      Int      @default(1)      // 1=open, 2=js-rendered, 3=captcha, 4=login, 5=paid sub, 6=bulk-license-only
  needsPlaywright Boolean  @default(false)  // true for Tier 2+ JS-rendered sites
  needsCaptcha    Boolean  @default(false)  // true for Tier 3 sites; captcha solver enabled per-scraper
  needsLogin      Boolean  @default(false)  // true for Tier 4; sessionCookie populated on first auth
  monthlyCostUsd  Float?                    // for Tier 5/6: subscription cost we factor into per-county budget
  sessionCookie   String?  @db.Text         // encrypted session token for Tier 4 logged-in scrapers

  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  errorCount      Int      @default(0)
  lastError       String?  @db.Text
  notes           String?  @db.Text

  scrapeJobs      ScrapeJob[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([state])
  @@index([status])
  @@index([accessTier])
}

// Audit log of scrape runs. Each row = one attempt to refresh a specific
// data category for a county. Used for debugging + retry logic.
model ScrapeJob {
  id              String   @id @default(cuid())
  scraperId       String
  category        String   // "tax_delinquency" | "assessment" | "foreclosure" | "lien" | "permit"
  triggerType     String   // "cron" | "on_demand" | "user_request"
  status          String   // "running" | "succeeded" | "failed"
  recordsScraped  Int      @default(0)
  recordsUpserted Int      @default(0)
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  durationMs      Int?
  errorMessage    String?  @db.Text
  details         Json?    // Free-form per-job metadata (URL hit, params, etc.)

  scraper         CountyScraper @relation(fields: [scraperId], references: [id], onDelete: Cascade)

  @@index([scraperId])
  @@index([status])
  @@index([startedAt])
}

// =============================================================================
// BULK DATA LAYER (Phase 1 — statewide bulk ingestion)
// =============================================================================
// Parcel is the NON-TENANT reference layer. Statewide bulk ingests (FL DOR /
// FloridaGIO, and later NY/MA/MT) write millions of rows here WITHOUT minting
// tenant-owned Property rows. A tenant Property links to a Parcel only when a
// user actually works that lead. This is the fix for the system-user explosion.

// One ROW per recorded mortgage. Time-series: a parcel can have 1..N
// mortgages over time (originals + refis + 2nd/3rd positions). Maps the
// Cotality mortgage domain (~252 fields collapsed into the key ones we
// extract from clerk-of-court ORI scrapes). Multi-source: Civitek ORI
// today, county-clerk fallbacks later, all coexist via `source` discriminator.
model Mortgage {
  id              String   @id @default(cuid())
  countyFips      String
  apn             String?                          // not always present on ORI; back-resolve via parcel join when possible
  position        Int?                             // 1=1st mortgage, 2=2nd, 3=3rd, null=unknown
  recordingDate   DateTime
  loanAmount      Float?
  interestRate    Float?
  lenderName      String?
  borrowerName    String?
  mortgageType    String?                          // Cotality MTGTP code (FIXED, ARM, PURCHASE, REFI, HELOC, etc.)
  documentNumber  String?                          // clerk OR doc number
  orBook          String?
  orPage          String?
  releasedAt      DateTime?                        // null = active; set when satisfaction is recorded
  releaseDocNum   String?

  source          String                           // "scraper:civitek-12031" | "scraper:clerk-12086" | ...
  capturedAt      DateTime @default(now())

  @@unique([countyFips, documentNumber, source])
  @@index([countyFips, apn, recordingDate])
  @@index([apn])
  @@index([recordingDate])
}

// One ROW per recorded lien event (mechanics, HOA, tax, judgment, lis pendens).
// Maps the Cotality HOA + Mechanics Liens v1 dictionary (55 fields → these
// extracted attrs). Mechanics + HOA liens are highest-value distress signals
// for our wholesale/flip product (motivated-seller indicators).
model Lien {
  id              String   @id @default(cuid())
  countyFips      String
  apn             String?
  lienCategory    String                           // "mechanics" | "hoa" | "tax" | "judgment" | "lis_pendens" | "other"
  recordingDate   DateTime
  filingDate      DateTime?
  amount          Float?
  interestRate    Float?
  plaintiffName   String?                          // claimant / lienholder
  plaintiffAddress String?
  defendantName   String?                          // property owner being lienned
  lienTypeCode    String?                          // Cotality DOCTY family
  documentNumber  String?
  orBook          String?
  orPage          String?
  releasedAt      DateTime?
  releaseDocNum   String?

  source          String
  capturedAt      DateTime @default(now())

  @@unique([countyFips, documentNumber, source])
  @@index([countyFips, apn, lienCategory, recordingDate])
  @@index([apn])
  @@index([lienCategory, recordingDate])
}

// One ROW per foreclosure stage transition. The Cotality FORECLOSURE STAGE
// CODE is a single field, but our scrape data is time-series (lis pendens →
// notice of sale → scheduled auction → sold/REO/dismissed). Each transition
// is its own row so the model learns the sequence.
model Foreclosure {
  id              String   @id @default(cuid())
  countyFips      String
  apn             String?
  stageCode       String                           // "NOD" | "LP" | "NTS" | "SCHEDULED" | "SOLD" | "REO" | "DISMISSED"
  filingDate      DateTime?
  auctionDate     DateTime?
  judgmentAmount  Float?
  openingBid      Float?
  surplusBid      Float?
  plaintiffName   String?
  caseNumber      String?
  trusteeId       String?                          // realauction case ID, when scraped from there

  source          String                           // "scraper:civitek-12031" | "scraper:realauction-duval" | ...
  capturedAt      DateTime @default(now())

  @@unique([countyFips, caseNumber, stageCode, source])
  @@index([countyFips, apn, stageCode, capturedAt])
  @@index([apn])
  @@index([auctionDate])
}

// One ROW per parcel sale event. Time-series: a parcel has 1..N sale rows
// (FL SDF goes back to 2009; future deed scrapes back to county availability).
// Keyed on (countyFips, apn, saleDate, source) so re-ingests are idempotent
// but multi-source captures coexist (DOR SDF + clerk scraper rows side by side).
model ParcelSale {
  id              String   @id @default(cuid())
  countyFips      String                       // natural key part 1
  apn             String                       // natural key part 2 (PARCEL_ID)
  saleDate        DateTime?                    // YYYY-MM-01 approx (SDF lacks day) or full from clerk records
  saleYear        Int?                         // SALE_YR
  saleMonth       Int?                         // SALE_MO
  salePrice       Float?                       // SALE_PRC
  qualCode        String?                      // QUAL_CD — FL DOR sale qualification (01-99)
  saleChangeCode  String?                      // SAL_CHNG_CD — type of transfer
  vacancyCode     String?                      // VI_CD — vacant/improved at time of sale
  orBook          String?                      // official record book
  orPage          String?                      // official record page
  clerkNumber     String?                      // clerk document number
  multiParcel     Boolean  @default(false)     // MULTI_PAR_SAL flag
  // Free-text classification for downstream feature derivation. Maps to
  // Cotality DEED CATEGORY TYPE CODE / DOCTY family after lookup.
  deedType        String?

  // Provenance
  source          String                       // "bulk:fl-dor-sdf-2025" | "scraper:civitek-12031" | ...
  dataVintage     String?                      // "2025"
  capturedAt      DateTime @default(now())

  @@unique([countyFips, apn, saleDate, source])
  @@index([countyFips, apn, saleDate])
  @@index([countyFips, saleDate])
  @@index([source])
}

model Parcel {
  id                  String   @id @default(cuid())
  countyFips          String                 // "12031"
  apn                 String                 // PARCEL_ID from the roll
  state               String                 // "FL"

  // Identity / ownership
  ownerName           String?
  ownerMailingAddress String?
  situsAddress        String?
  situsCity           String?
  situsState          String?
  situsZip            String?

  // Values
  marketValue         Float?                 // JV (just value)
  assessedValue       Float?                 // AV_SD
  landValue           Float?                 // LND_VAL

  // Characteristics
  propertyType        String?                // DOR_UC land-use code
  yearBuilt           Int?                   // ACT_YR_BLT
  squareFeet          Int?                   // TOT_LVG_AR
  lotSize             Float?                 // LND_SQFOOT

  // Additional NAL building fields (Phase 0 — free, statewide; AVM + UI).
  // Already in the DOR NAL file we ingest; captured 2026-06-13.
  effectiveYearBuilt  Int?                   // EFF_YR_BLT — renovation-aware age
  improvementQuality  Int?                   // IMP_QUAL (1-6 Marshall&Swift grade) — condition proxy
  specialFeatureValue Float?                 // SPEC_FEAT_VAL — $ lump for pool/dock/extra features
  numResUnits         Int?                   // NO_RES_UNTS — residential units

  // Last sale (from roll)
  lastSalePrice       Float?                 // SALE_PRC1
  lastSaleYear        Int?                   // SALE_YR1

  // Derived (computed by scripts/derive-* SQL passes, not scraped)
  ownerOccupied       Boolean?               // situs ≈ mailing address compare

  // Geometry (optional — centroid for map pins; full polygon deferred)
  latitude            Float?
  longitude           Float?

  // Provenance
  source              String                 // "bulk:fl-fgio-2025"
  dataVintage         String?                // "2025"
  fetchedAt           DateTime @default(now())

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([countyFips, apn])
  @@index([countyFips])
  @@index([situsZip])
  @@index([state])
  @@index([source])
}

// ---------------------------------------------------------------------------
// TaxDelinquencySummary — Option A Phase A2 materialized aggregate.
//
// Pre-computes one row per (countyFips, apn) combining all Lien rows with
// lienCategory='tax' for that parcel. Refreshed via single SQL upsert
// (scripts/rescore-tax-delinquent.ts) after each tax-delinquent scraper run,
// plus a daily safety-net cron at lib/cron/discovery/tax-delinquent-summary.ts.
//
// Per the verifier of OPTION-A-LEADS-INTEGRATION-DESIGN.json, the score /
// grade / motivation columns are MATERIALIZED here (not computed on-the-fly
// post-fetch) so the /api/properties UNION can ORDER BY score in SQL and
// support scoreMin filtering without an over-fetch-and-rescore loop. This is
// the linchpin that makes API pagination tractable across virtual leads.
// See docs/development/OPTION-A-LEADS-INTEGRATION-DESIGN.json verdict.fix #1.
// ---------------------------------------------------------------------------
model TaxDelinquencySummary {
  countyFips        String
  apn               String
  totalAmount       Float     // SUM of unpaid certificate amounts across all years
  yearsCount        Int       // distinct delinquent tax years for this APN
  earliestYear      Int
  latestYear        Int
  certificateCount  Int       // distinct (apn, taxYear) rows in Lien

  // Materialized score (verifier's linchpin fix).
  // Computed in the same SQL aggregate via CASE expressions that mirror
  // quickDistressScore's tax-delinquent path. Enables SQL-side ORDER BY.
  score             Int?      // 0-100, null if amount/years insufficient
  grade             String?   // "A" | "B" | "C" | "D" | "F"
  motivation        String?   // short human-readable motivation summary

  // M2.4 Layer-1 output: calibrated P(qualified sale within 12 months), 0..1.
  // Written ONLY by scripts/ml/apply-predictions.ts in chunked batch UPDATEs.
  // NULL = never scored by a model (cold-start rows fall back to the
  // hand-tuned scorer — SCORING-ARCHITECTURE invariant #5).
  propensity12mo           Float?
  // ModelVersion.id provenance (invariant #1: every stored score carries its
  // model version). FK-by-value, no relation.
  propensityModelVersionId String?

  computedAt        DateTime  @default(now())

  @@id([countyFips, apn])
  @@index([countyFips])
  @@index([totalAmount])
  @@index([score(sort: Desc)])
  @@index([countyFips, score(sort: Desc)])
  @@index([propensity12mo(sort: Desc)])
}

// ---------------------------------------------------------------------------
// AuctionSummary — Option A Phase M2.1 materialized aggregate.
//
// Pre-computes one row per (countyFips, apn) combining all Foreclosure rows
// for that parcel. Foreclosure's unique key is (countyFips, caseNumber,
// stageCode, source) so a single parcel can have many Foreclosure rows when
// auctions get rescheduled, dismissed-and-refiled, or captured across sources.
// AuctionSummary collapses those into a single materialized lead row keyed by
// parcel, with score/grade/motivation materialized so the /api/properties
// UNION can ORDER BY score in SQL (verifier HG2 in OPTION-A doc).
//
// nextAuctionDate := MIN(auctionDate WHERE stageCode='SCHEDULED' AND auctionDate > NOW())
// ---------------------------------------------------------------------------
model AuctionSummary {
  id                 String   @id @default(cuid())
  countyFips         String
  apn                String
  nextAuctionDate    DateTime?
  pastAuctionCount   Int      @default(0)   // SOLD + DISMISSED
  scheduledCount     Int      @default(0)
  judgmentAmountMax  Float?
  openingBidMin      Float?
  lastCaseNumber     String?
  firstCapturedAt    DateTime
  lastCapturedAt     DateTime
  // Materialized scoring (linchpin)
  score              Int?
  grade              String?  // A/B/C/D/F
  motivation         String?
  updatedAt          DateTime @updatedAt

  @@unique([countyFips, apn])
  @@index([score(sort: Desc)])
  @@index([countyFips, score(sort: Desc)])
  @@index([nextAuctionDate])
}

// Audit log of bulk ingest runs (sibling of ScrapeJob, for the bulk modality).
// EXTENDED 2026-05-30 for the freshness layer (see docs/development/FRESHNESS-LAYER-PLAN.md):
// becomes the unified run-audit log for both legacy bulk ingest (sourceKey=NULL)
// and new freshness-layer scrapers (sourceKey FK to ScrapeRegistry).
model BulkIngestJob {
  id                String   @id @default(cuid())
  sourceTag         String                     // "bulk:fl-fgio" (free-form provenance)
  scope             String                     // county FIPS ("12031") or state ("FL")
  status            String                     // "running" | "succeeded" | "failed"
  recordsFetched    Int      @default(0)
  recordsUpserted   Int      @default(0)
  startedAt         DateTime @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  errorMessage      String?  @db.Text
  cursor            String?                    // resumption checkpoint (resultOffset)

  // Freshness-layer extensions (nullable for legacy rows)
  sourceKey         String?                              // FK to ScrapeRegistry.sourceKey
  registry          ScrapeRegistry? @relation(fields: [sourceKey], references: [sourceKey])
  rejectCount       Int      @default(0)                // hallucination-guard rejects
  http4xxCount      Int      @default(0)
  http5xxCount      Int      @default(0)
  cfChallengeCount  Int      @default(0)
  selectorMissRate  Float?                              // % of CSS selectors returning 0 results
  runStatsJson      Json?                               // extensibility
  tier              String?                             // "P1" | "P2" | "OK" (set by scraper-health)
  triggerType       String   @default("scheduler")      // "scheduler" | "manual-script" | "manual-admin" | "backfill"

  @@index([sourceTag])
  @@index([status])
  @@index([startedAt])
  @@index([sourceKey])
}

// Freshness-layer registry. Declarative source-of-truth for every scraper the
// scheduler should run. Replaces the FIPS-keyed CountyScraper model for
// scheduled bulk scrapers (CountyScraper stays alive for the on-demand
// `refreshCounty()` path in lib/data-sources/index.ts — different use case).
// See docs/development/FRESHNESS-LAYER-PLAN.md for the full design.
model ScrapeRegistry {
  id                     String   @id @default(cuid())
  sourceKey              String   @unique           // "duval-tax-delinquent", "duval-clerk"
  domain                 String                      // "jaxdailyrecord.com" (queue-grouping key)
  countyFips             String?                     // optional; null for statewide
  state                  String?                     // "FL"
  scraperFn              String                      // dispatch-map key, e.g. "scrapeDuvalTaxDelinquent"
  cronExpr               String                      // "0 6 * * *" — validated at write + boot
  strategy               String                      // "full" | "incremental-date" | "incremental-id" | "snapshot-diff" | "head-check"
  enabled                Boolean  @default(true)
  bootstrapping          Boolean  @default(true)     // cleared once baseline established
  seasonStartMonth       Int?                        // 1-12; null = year-round
  seasonEndMonth         Int?
  legalRisk              String                      // REQUIRED — "green" | "yellow" | "red"
  rateLimitMs            Int      @default(1500)     // baseline politeness (Redis enforces)
  priority               Int      @default(0)        // tie-breaker for same-minute collisions
  timezone               String   @default("America/New_York")
  proxyMode              String   @default("none")   // "none" | "bd-on" | "bd-rotate"

  // Run state
  lastRunAt              DateTime?
  lastSuccessAt          DateTime?
  lastFailureAt          DateTime?
  lastFailureReason      String?  @db.Text
  lastHighWaterMark      String?                     // cursor for next run (date or max-id)
  lastRowCount           Int?
  rollingMedianRowCount  Int?                        // computed by health-check
  consecutiveFails       Int      @default(0)
  consecutiveP1Alerts    Int      @default(0)        // for @channel escalation policy
  pausedReason           String?                     // populated when health-check auto-pauses

  notes                  String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  bulkIngestJobs         BulkIngestJob[]

  @@index([enabled, cronExpr])
  @@index([domain])
  @@index([countyFips])
}

// =============================================================================
// ML DATA LAYER — raw preservation (bronze) + behavioral signals
// =============================================================================
// CRITICAL: never discard raw source data. The normalized Parcel/Property layer
// is lossy (keeps only winning field values); ML training needs the FULL raw
// responses + their change-over-time. These two tables are append-only.

// Bronze layer: the complete, immutable raw response from every scrape / API /
// enrichment call. One row per fetch — NEVER updated. Captures the full payload
// (all fields, not just the ones we extract) so re-scrapes form a time series.
// This is the training corpus for lead scoring + data-quality models.
model RawSnapshot {
  id            String   @id @default(cuid())

  // What this snapshot is about
  entityType    String   // "parcel" | "property" | "owner"
  countyFips    String?
  apn           String?
  propertyId    String?

  // Where it came from
  source        String   // "firecrawl" | "fl-fgio" | "batchdata" | "versium" | etc.
  sourceTag     String   // canonical provenance tag (e.g. "scraper:appraiser-12031")
  category      String?  // "appraiser" | "clerk_records" | "tax_delinquency" | "skip_trace" | "bulk_roll"

  // The raw payload — the WHOLE thing, immutable
  requestParams Json?    // url, query, schema we sent
  rawResponse   Json     // full response: Firecrawl json+markdown+metadata, FeatureServer attrs, API body
  contentHash   String   // sha256(rawResponse) — dedup + change detection across re-scrapes

  // Per §5.1 of [FL-COVERAGE-PLAN.md]: every scrape carries the legal-risk
  // zone it was sourced from so we can purge yellow-zone data with one SQL
  // if a cease-and-desist arrives. Default "green" for backwards-compat.
  // "red" is reserved for hard-locked sources that MUST NEVER appear here —
  // if a row has legalRisk="red", that's a policy violation to investigate.
  legalRisk     String?  @default("green") // "green" | "yellow" | "red"
  egressIp      String?  // residential proxy session IP, when applicable
  proxySession  String?  // Bright Data session ID for replay/audit

  capturedAt    DateTime @default(now())

  @@index([entityType, countyFips, apn])
  @@index([propertyId])
  @@index([source])
  @@index([category])
  @@index([capturedAt])
  @@index([contentHash])
  @@index([legalRisk])
}

// Behavioral layer: every user interaction with a lead, with a snapshot of the
// lead's attributes AT THE TIME of the action. This is what lets us train a
// per-user model of "what makes a great lead for YOU" — the behavioral scoring
// engine. Append-only.
model LeadEvent {
  id            String   @id @default(cuid())
  userId        String?  // null for pre-auth/anonymous events; linked at signup via sessionId
  sessionId     String?  // client-generated anonymous session id (pre-launch label capture)
  propertyId    String?
  parcelId      String?

  eventType     String   // "viewed" | "opened" | "pursued" | "skipped" | "called" |
                         // "texted" | "emailed" | "offer_made" | "contract_signed" |
                         // "closed" | "marked_dead" | "saved" | "enriched"

  // Snapshot of the lead's scoring-relevant attributes at event time.
  // The model learns from the DELTA between pursued vs skipped snapshots.
  leadSnapshot  Json     // { score, marketValue, assessedValue, equity, distressSignals,
                         //   propertyType, yearBuilt, sqft, county, daysOnMarket, ... }
  metadata      Json?    // event-specific extras (call duration, offer amount, disposition, etc.)

  occurredAt    DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([propertyId])
  @@index([eventType])
  @@index([occurredAt])
  @@index([userId, eventType])
}
// ---------------------------------------------------------------------------
// ParcelFeature — model-ready feature mart ("silver" layer), one row per
// parcel in active metros (start: Duval 12031 + Miami-Dade 12086).
//
// Populated by a future scripts/ml/build-parcel-features.ts (single SQL UPSERT
// per county, mirrors rescore-tax-delinquent.ts). Read paths:
//   - scripts/ml/export-training-data.ts  (training frame export)
//   - M2.4 batch inference (apply-predictions.ts reads features, writes
//     propensity back to TaxDelinquencySummary)
// ---------------------------------------------------------------------------
model ParcelFeature {
  id                      String   @id @default(cuid())

  // Natural key — joins by value to Parcel / TaxDelinquencySummary /
  // AuctionSummary. Same convention as the other materialized marts.
  countyFips              String                 // "12031"
  apn                     String                 // PARCEL_ID from the roll

  // -- Location (denormalized for grouping / spatial features) ------------
  situsZip                String?                // 5-digit ZIP from Parcel
  latitude                Float?                 // centroid (M1.3 geocode)
  longitude               Float?

  // -- Value features ------------------------------------------------------
  marketValue             Float?                 // JV copy (export convenience)
  assessedValue           Float?                 // AV_SD copy
  // assessedValue / marketValue. The "assessed-ratio baseline" in
  // SCORING-ARCHITECTURE invariant #2 is built directly on this ratio —
  // it is the floor every learned model must beat.
  assessedToMarketRatio   Float?
  landToMarketRatio       Float?                 // landValue / marketValue
  // marketValue / squareFeet — cheap AVM-ish normalizer, NULL when sqft=0.
  valuePerSqft            Float?

  // -- Physical characteristics -------------------------------------------
  squareFeet              Int?                   // TOT_LVG_AR
  lotSize                 Float?                 // LND_SQFOOT
  ageYears                Int?                   // computedAt.year - ACT_YR_BLT
  propertyType            String?                // DOR_UC land-use code (categorical)

  // -- Ownership / occupancy ----------------------------------------------
  ownerOccupied           Boolean?               // situs ≈ mailing compare (derive-owner-occupancy)
  absenteeOwner           Boolean?               // NOT ownerOccupied, mailing present
  outOfStateOwner         Boolean?               // mailing state != "FL"
  corporateOwner          Boolean?               // ownerName matches LLC/INC/CORP/TRUST pattern

  // -- Sale recency ---------------------------------------------------------
  lastSalePrice           Float?                 // most recent ParcelSale (or roll SALE_PRC1)
  yearsSinceLastSale      Float?                 // computedAt - last saleDate, years

  // -- Per-signal-family flags + ages --------------------------------------
  // One (flag, ageDays) pair per scorer v2.1 family that has real data today.
  // ageDays = days since the family's anchor event at computedAt; NULL when
  // the flag is false. Families without a data source yet (VACANCY, LIFE_EVENT,
  // EQUITY, CONDITION) get columns when their scrapers land — add them here
  // with a featureVersion bump, never reuse a column.

  // TAX_FAMILY — anchor: delinquency onset = Apr 1 of (earliestYear + 1),
  // the FL Ch.197 statutory delinquency date for tax year earliestYear.
  taxDelinquent           Boolean  @default(false)
  taxDelinquencyAgeDays   Int?
  taxYearsCount           Int?                   // TaxDelinquencySummary.yearsCount
  taxTotalAmount          Float?                 // TaxDelinquencySummary.totalAmount

  // FORECLOSURE_FAMILY — anchor: earliest Foreclosure.filingDate (fallback
  // firstCapturedAt). auctionInDays is signed: negative = future auction.
  foreclosureActive       Boolean  @default(false)
  foreclosureAgeDays      Int?
  auctionScheduled        Boolean  @default(false)
  auctionInDays           Int?                   // nextAuctionDate - computedAt, days

  // -- ZIP aggregates (FK-by-value snapshot from ZipMarketStats) ------------
  // Copied at compute time, NOT joined at read time — see header decision #1.
  zipMedianSalePrice      Float?
  zipPricePerSqft         Float?
  zipSaleVelocity12mo     Float?                 // qualified sales / parcel, trailing 12mo
  zipTrend12moPct         Float?                 // median price t12m vs prior 12m, percent

  // -- Versioning / provenance ----------------------------------------------
  featureVersion          Int      @default(1)   // bump on ANY semantic change
  computedAt              DateTime @default(now())

  @@unique([countyFips, apn])
  // Export scan: WHERE countyFips = $1 AND featureVersion = $2 ORDER BY apn
  // (keyset pagination on apn within county).
  @@index([countyFips, featureVersion, apn])
  @@index([situsZip])
  @@index([computedAt])
}

// ---------------------------------------------------------------------------
// ZipMarketStats — per-ZIP market aggregates from ParcelSale × Parcel.
//
// Refresh cadence: monthly with the retrain (SCORING-ARCHITECTURE "Cadence"),
// or after major sale-history lands (M2.7 SDF backfill). Single SQL UPSERT.
// "Qualified sale" = salePrice >= $10k arm's-length proxy until DOR qualCode
// mapping is finalized — keep this definition in sync with
// scripts/ml/export-training-data.ts (QUALIFIED_SALE_FLOOR).
// ---------------------------------------------------------------------------
model ZipMarketStats {
  // 5-digit ZIP as primary key — one row per ZIP, nationwide-safe.
  zip                String   @id
  state              String                  // "FL" — partition for state-scoped refresh

  medianSalePrice    Float?                  // median qualified sale price, trailing 12mo
  pricePerSqft       Float?                  // median (salePrice / squareFeet), trailing 12mo
  // Turnover: qualified sales trailing 12mo / parcel count in ZIP.
  // A rate (not raw count) so dense Miami-Dade ZIPs and rural ZIPs compare.
  saleVelocity12mo   Float?
  // Median qualified price trailing 12mo vs the PRIOR 12mo window, percent.
  // NULL when either window has < minimum sample.
  trend12moPct       Float?
  // Qualified-sale count in the trailing-12mo window. Consumers (and the
  // hierarchical shrinkage in M2.4) MUST treat small-sample ZIPs with
  // suspicion — shrink toward the county/state prior, don't trust a median
  // of 3 sales.
  sampleSize         Int      @default(0)

  computedAt         DateTime @default(now())

  @@index([state])
}

// ---------------------------------------------------------------------------
// ModelVersion — registry for every trained model artifact.
// SCORING-ARCHITECTURE invariant #1: every stored score carries its model
// version; no silent weight changes. Invariant #2: a version is `promoted`
// only after it beats the incumbent on holdout (calibration-by-decile +
// ranking AUC) AND the assessed-ratio baseline floor.
//
// Rows are written by the training loop (see scripts/ml/README.md step 4),
// never deleted — demote by flipping `promoted`, keep the row for provenance.
// ---------------------------------------------------------------------------
model ModelVersion {
  id          String   @id @default(cuid())

  // Stable model family identifier: "propensity-v1" (M2.4 Layer 1),
  // later "account-ranker" (M3 Layer 2). The KEY names the problem;
  // `version` counts retrains within the key.
  modelKey    String
  version     Int                              // monotonically increasing per modelKey
  trainedAt   DateTime @default(now())

  // metrics.json from train_propensity.py verbatim: { auc, baselineAuc,
  // calibrationByDecile: [{decile, meanPredicted, observedRate, n}],
  // nTrainRows, nHoldoutRows, params, labelWindow }.
  metrics     Json
  // Ordered feature names exactly as the booster consumed them — required to
  // reproduce inference and to diff feature drift between versions.
  featureList Json
  // True for at most ONE version per modelKey at a time (enforced in the
  // promote script, not the DB — partial unique indexes aren't expressible
  // in Prisma). apply-predictions.ts refuses to write scores from an
  // unpromoted version unless --force.
  promoted    Boolean  @default(false)
  notes       String?                          // human context: "first Civitek-era retrain", eval caveats

  createdAt   DateTime @default(now())

  @@unique([modelKey, version])
  @@index([modelKey, promoted])
}

// ===== merged from schema.patch.probate.prisma (M3 Wave D1) =====
model ProbateCase {
  id                     String   @id @default(cuid())
  countyFips             String                  // "12095" (Orange), "12086" (Miami-Dade), ...
  caseNumber             String                  // clerk case # e.g. "2026-CP-001234" / "482026CP001234..."

  // Index fields (the listable, public docket index — NOT the confidential inventory)
  decedentName           String                  // estate party / decedent (raw, as printed)
  decedentNameNormalized String?                 // uppercased, suffix/punct-stripped (matcher key)
  personalRepresentative String?                 // PR / petitioner / executor when present in index
  caseTypeRaw            String?                  // portal case-type label e.g. "Formal Administration"
  caseTypeCode           String?                 // normalized: "FORMAL_ADMIN"|"SUMMARY_ADMIN"|"GUARDIANSHIP"|"DISPOSITION_NO_ADMIN"|"TRUST"|"CAVEAT"|"OTHER"
  filedAt                DateTime?               // case filing date
  status                 String?                 // "OPEN" | "CLOSED" | portal status string
  prAppointedAt          DateTime?               // letters-of-administration / PR appointment date (peak-motivation signal)

  // Decedent vitals + petitioner's counsel — carried by feeds that publish them
  // (Pinellas publicfiles daily CSV); NULL for feeds/portals that don't.
  decedentDob            DateTime?               // decedent's date of birth
  decedentDateOfDeath    DateTime?               // decedent's date of death — dates the peak-motivation window better than filing date
  attorneyName           String?                 // petitioner's attorney (assembled "FIRST MIDDLE LAST")
  attorneyAddress        String?                 // petitioner's attorney mailing address (free-text, as printed)

  // Fuzzy parcel link (NOT an FK — see header). Array of matched Parcel.apn
  // within countyFips; matchConfidence is the BEST match's score 0..1.
  matchedParcelApns      String[] @default([])
  matchConfidence        Float?                  // 0..1, best-match confidence; NULL = unmatched/not yet run
  matchTier              String?                 // "EXACT" | "STRONG" | "WEAK" | "NONE"

  // Provenance
  source                 String                  // "probate:orange-myeclerk" | "probate:broward-web2" | "probate:miamidade-ocs" | ...
  rawCaptureId           String?                 // bronze ref → RawCapture.id (captureRaw output); raw docket JSON/HTML
  capturedAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([countyFips, caseNumber])
  @@index([countyFips])
  @@index([filedAt])
  @@index([decedentDateOfDeath])                // peak-motivation window driver — sort/filter by death recency
  @@index([caseTypeCode])
  @@index([decedentNameNormalized])             // decedent-name → Parcel.ownerName fuzzy-join driver
  @@index([source])
}

// ---------------------------------------------------------------------------
// ProbateSummary — materialized per-(countyFips, apn) lead aggregate.
//
// Mirrors AuctionSummary/TaxDelinquencySummary. One row per matched parcel,
// collapsing all ProbateCase rows whose matchedParcelApns include this apn.
// score/grade/motivation are MATERIALIZED (the verifier linchpin) so the
// /api/properties UNION can ORDER BY score + filter scoreMin in SQL without an
// over-fetch-and-rescore loop. Refreshed by a single SQL upsert in
// scripts/rescore-probate.ts (next wave), mirroring scripts/rescore-auction.ts.
//
// Cross-branch dedup (next wave, per the M2.3 AuctionSummary precedent): the
// probate-virtual branch should yield to a future-scheduled foreclosure/auction
// on the same (countyFips, apn) — probate is a motivation signal, not a clock.
// ---------------------------------------------------------------------------
model ProbateSummary {
  id                 String   @id @default(cuid())
  countyFips         String
  apn                String

  caseCount          Int      @default(1)        // distinct ProbateCase rows matched to this apn
  primaryCaseNumber  String?                      // most-recent / highest-confidence case
  decedentName       String?
  personalRepresentative String?
  caseTypeCode       String?
  filedAt            DateTime?                    // earliest matched filing
  prAppointedAt      DateTime?                    // PR appointment (peak window)
  dateOfDeath        DateTime?                    // decedent's date of death (latest across matched cases) — peak-window driver
  status             String?
  matchConfidence    Float?                       // best-match confidence carried up for UI/filtering

  // Materialized scoring (linchpin — same contract as AuctionSummary)
  score              Int?
  grade              String?                      // A/B/C/D/F
  motivation         String?

  firstCapturedAt    DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([countyFips, apn])
  @@index([countyFips])
  @@index([score(sort: Desc)])
  @@index([countyFips, score(sort: Desc)])
  @@index([prAppointedAt])
  @@index([dateOfDeath])
  @@index([matchConfidence(sort: Desc)])
}

// ===== merged from schema.patch.code.prisma (M3 Wave D1) =====
model CodeViolation {
  id            String    @id @default(cuid())

  // Natural join key (by value, no relation). parcelApn NULL when the feed only
  // gives an unresolvable id / address (resolved later by address fuzzy-match).
  countyFips    String                       // "12086" Miami-Dade, "12095" Orange/Orlando
  parcelApn     String?                      // DOR PARCEL_ID / folio when it joins

  // Provenance: stable id from the source feed (Miami-Dade CASE_NUM, Orlando
  // apno). Combined with `source` to dedup across re-ingests.
  sourceCaseId  String
  source        String                       // "opendata:miamidade-ccv" | "opendata:orlando-ce" | "scraper:accela-<jur>"

  // Address (always present from the feed; the only locator when parcelApn is null).
  address       String?
  city          String?
  zip           String?

  // Violation classification (free-text from the feed; normalized category derived).
  violationType String?                      // e.g. "Construction Without Permit", "High Weeds/Litter"
  category      String?                      // normalized bucket: structure|nuisance|zoning|vehicle|other

  // Lifecycle. status is normalized to "open" | "closed" | "unknown"; the raw
  // feed status string is kept in rawStatus for audit/debug.
  status        String                       // normalized "open" | "closed" | "unknown"
  rawStatus     String?                      // feed's literal status ("Open", "1", "Closed", "CLOSED - LIEN")
  openedAt      DateTime?
  closedAt      DateTime?

  // CODE_LIEN signal driver. True when the feed flags a recorded code-enforcement
  // lien on the case (Miami-Dade LN_RFRL / LN_RECDATE; Accela lien activity).
  isLien        Boolean   @default(false)
  lienRecordedAt DateTime?
  lienBook      String?
  lienPage      String?

  // Optional centroid for map / address-join fallback.
  latitude      Float?
  longitude     Float?

  capturedAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([countyFips, sourceCaseId, source])
  // Per-parcel aggregation (summary refresh) + scorer hydration at promote time.
  @@index([countyFips, parcelApn])
  // "open violations in county X" sweeps.
  @@index([countyFips, status])
  @@index([source])
  @@index([capturedAt])
}

// ---------------------------------------------------------------------------
// CodeViolationSummary — per-parcel aggregate the SCORER reads, mirroring
// TaxDelinquencySummary. One row per (countyFips, apn) with the three fields
// the CONDITION_FAMILY signals need:
//   openCount      → CODE_VIOLATION_OPEN (>=1) and CODE_VIOLATION_MULTI (>=3)
//   hasLien        → CODE_LIEN
//   latestOpenedAt → recency / age decay
// Refreshed by scripts/rescore-code-violations.ts (single SQL UPSERT, chunked
// per county). score/grade are materialized for the UNION list-ranking path
// the same way the other *Summary marts pre-materialize them.
// ---------------------------------------------------------------------------
model CodeViolationSummary {
  countyFips     String
  apn            String

  openCount      Int       @default(0)   // COUNT of open CodeViolation for this parcel
  totalCount     Int       @default(0)   // COUNT of all (open+closed) for context
  hasLien        Boolean   @default(false)
  earliestOpenedAt DateTime?
  latestOpenedAt DateTime?

  // Distinct normalized violation categories present (e.g. {structure,nuisance}).
  categories     String[]  @default([])

  // Materialized for SQL-side ORDER BY in the /api/properties UNION (same as the
  // other *Summary marts). The authoritative formula stays in distress-scorer.ts;
  // this is the batch-aggregation mirror for list ranking only.
  score          Int?                    // 0-100
  grade          String?                 // "A" | "B" | "C" | "D" | "F"
  motivation     String?                 // short human-readable summary

  computedAt     DateTime  @default(now())

  @@id([countyFips, apn])
  @@index([countyFips])
  @@index([openCount])
  @@index([score(sort: Desc)])
}

// ===== merged from schema.patch.avm.prisma (M3 Wave D1) =====
model ParcelValuation {
  id              String   @id @default(cuid())

  // Natural key — joins by value to Parcel / ParcelFeature. Same convention as
  // the other materialized marts. Unique so apply-avm.ts can UPSERT.
  countyFips      String                 // "12086"
  apn             String                 // PARCEL_ID from the roll

  // -- Estimate (the AVM output) ------------------------------------------
  // estimatedValue is the point estimate in dollars (model predicts log-price;
  // apply-avm.ts exponentiates). low/high bracket it — see header decision #3.
  estimatedValue  Float
  lowEstimate     Float?
  highEstimate    Float?

  // -- Provenance ----------------------------------------------------------
  // ModelVersion.id that produced this estimate (FK-by-value, no relation).
  // Invariant #1: every stored estimate carries its model version.
  modelVersionId  String

  computedAt      DateTime @default(now())

  @@unique([countyFips, apn])
  // List/lookup scans are county-scoped (one metro at a time).
  @@index([countyFips])
}
