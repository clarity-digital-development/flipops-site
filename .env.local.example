# Auth.js (NextAuth v5) — Credentials provider (email + password)
# Generate AUTH_SECRET with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=your_auth_secret_here
# Base URL Auth.js uses for callbacks/redirects (prod: https://flipops.io)
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (to be added)
# DATABASE_URL=postgresql://user:password@localhost:5432/flipops

# Redis (to be added)
# REDIS_URL=redis://localhost:6379

# Storage (to be added)
# STORAGE_BUCKET_URL=s3://flipops-bucket

# Email
EMAIL_FROM=noreply@flipops.com
